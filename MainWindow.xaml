<Window x:Class="SOCDOF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource ContentBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Image x:Name="AppLogo"
                           Height="52"
                           Margin="0,0,0,16"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           ToolTip="SOCDOF 2.0" />
                    <TextBlock x:Name="SidebarAppName"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               Text="Offline workspace" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,40,0,10"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SidebarMutedBrush}"
                           Text="NAVIGATION" />

                <StackPanel Grid.Row="2">
                    <Button Click="DashboardButton_OnClick"
                            Content="⌂    Dashboard"
                            Style="{StaticResource NavigationButtonStyle}" />
                    <Button Click="PartnersButton_OnClick"
                            Content="♙    Partner"
                            Style="{StaticResource NavigationButtonStyle}" />
                    <Button Click="ProductsButton_OnClick"
                            Content="▦    Produkte"
                            Style="{StaticResource NavigationButtonStyle}" />
                    <Button Click="SalesButton_OnClick"
                            Content="◫    Verkäufe"
                            Style="{StaticResource NavigationButtonStyle}" />
                    <Button Click="InventoryButton_OnClick"
                            Content="⇄    Lager"
                            Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="#33434D" />
                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               Text="Version" />
                    <TextBlock x:Name="SidebarVersion"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="PageAppName"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentDarkBrush}" />
                    <TextBlock x:Name="PageTitle"
                               Margin="0,6,0,0"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Dashboard" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

            <ContentControl x:Name="ModuleContent" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
