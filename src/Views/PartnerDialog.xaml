<Window x:Class="SOCDOF.Views.PartnerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DialogTitle"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Text="Neuen Partner anlegen" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,24"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Kunden- oder Lieferantendaten lokal speichern" />

        <TextBlock Grid.Row="2" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Name *" />
        <TextBox x:Name="NameBox"
                 Grid.Row="3"
                 Margin="0,7,0,14"
                 Padding="10,8"
                 FontSize="14" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="E-Mail" />
                <TextBox x:Name="EmailBox"
                         Margin="0,7,0,14"
                         Padding="10,8"
                         FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Telefon" />
                <TextBox x:Name="PhoneBox"
                         Margin="0,7,0,14"
                         Padding="10,8"
                         FontSize="14" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Adresse" />
        <TextBox x:Name="AddressBox"
                 Grid.Row="6"
                 Height="76"
                 Margin="0,7,0,24"
                 Padding="10,8"
                 AcceptsReturn="True"
                 FontSize="14"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="7" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Click="CancelButton_OnClick"
                    Content="Abbrechen"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="SaveButton"
                    Click="SaveButton_OnClick"
                    Content="Speichern"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
