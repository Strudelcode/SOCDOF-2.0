<Window x:Class="SOCDOF.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DialogTitle"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Text="Neues Produkt anlegen" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,24"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Stammdaten erfassen; Bestände werden im Lager gebucht" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="SKU *" />
                <TextBox x:Name="SkuBox"
                         Margin="0,7,0,14"
                         Padding="10,8"
                         FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Einheit *" />
                <TextBox x:Name="UnitBox"
                         Margin="0,7,0,14"
                         Padding="10,8"
                         FontSize="14" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Name *" />
        <TextBox x:Name="NameBox"
                 Grid.Row="4"
                 Margin="0,7,0,14"
                 Padding="10,8"
                 FontSize="14" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Preis *" />
                <TextBox x:Name="PriceBox"
                         Margin="0,7,0,14"
                         Padding="10,8"
                         FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Aktueller Bestand" />
                <TextBox x:Name="StockBox"
                         Margin="0,7,0,14"
                         Padding="10,8"
                         FontSize="14"
                         IsReadOnly="True"
                         Background="#EAF0F2" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6"
                   Margin="0,0,0,24"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Bestandsänderungen werden ausschließlich über das Lager gebucht und protokolliert."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Click="CancelButton_OnClick"
                    Content="Abbrechen"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="SaveButton"
                    Click="SaveButton_OnClick"
                    Content="Speichern"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
