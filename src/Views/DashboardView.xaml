<UserControl x:Class="SOCDOF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,28,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Deine Geschäftsdaten auf einen Blick" />
                    <TextBlock x:Name="LastUpdatedText"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="NewPartnerButton_OnClick"
                            Content="+  Neuer Partner"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Click="NewProductButton_OnClick"
                            Content="+  Neues Produkt"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Click="NewSaleButton_OnClick"
                            Content="+  Neuer Verkauf"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="PARTNER" />
                        <TextBlock x:Name="PartnerCountText"
                                   Margin="0,10,0,0"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Kunden und Lieferanten" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="20"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="PRODUKTE" />
                        <TextBlock x:Name="ProductCountText"
                                   Margin="0,10,0,0"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="LowStockText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource AccentDarkBrush}"
                                   Text="0 mit niedrigem Bestand" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="20"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="VERKÄUFE" />
                        <TextBlock x:Name="OrderCountText"
                                   Margin="0,10,0,0"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="RevenueText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource AccentDarkBrush}"
                                   Text="0,00 EUR Umsatz" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,12"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="Letzte Aktivitäten" />

                <DataGrid x:Name="ActivityGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          Foreground="{StaticResource TextBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="1.4*" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding ActivityType}" Width="1.2*" />
                        <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2.5*" />
                        <DataGridTextColumn Header="Wert" Binding="{Binding ValueDisplay}" Width="1.4*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyActivityState"
                        Grid.Row="1"
                        Padding="32"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="Noch keine Aktivitäten" />
                        <TextBlock MaxWidth="460"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Verkaufsaufträge und Lagerbewegungen erscheinen hier, sobald du sie erfasst."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
