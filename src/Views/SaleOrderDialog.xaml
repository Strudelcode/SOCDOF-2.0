<Window x:Class="SOCDOF.Views.SaleOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820"
        Height="650"
        MinWidth="720"
        MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Text="Neuen Verkauf anlegen" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,24"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Partner und Produktpositionen auswählen; der Bestand wird beim Abschluss gebucht." />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="Partner *" />
                <TextBlock Margin="0,0,224,0"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="Liefertermin" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,7,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PartnerBox"
                          Grid.Column="0"
                          DisplayMemberPath="Name"
                          FontSize="14"
                          SelectionChanged="PartnerBox_OnSelectionChanged" />
                <DatePicker x:Name="DeliveryDatePicker"
                            Grid.Column="2"
                            SelectedDateFormat="Short"
                            ToolTip="Optionaler Liefertermin" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Text="Positionen *" />
                    <Button HorizontalAlignment="Right"
                            Click="AddLineButton_OnClick"
                            Content="+  Position hinzufügen"
                            IsEnabled="False"
                            x:Name="AddLineButton"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <DataGrid x:Name="LinesGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Produkt" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="ProductBox_OnSelectionChanged" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Menge" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="1*" />
                        <DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="1.2*" />
                        <DataGridTextColumn Header="Zeilensumme" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" IsReadOnly="True" Width="1.3*" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="RemoveLineButton_OnClick"
                                            Content="Entfernen"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="#B42318"
                       TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Margin="0,0,24,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Text="Gesamtsumme:" />
                <TextBlock x:Name="TotalText"
                           Margin="0,0,24,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentDarkBrush}" />
                <Button Margin="0,0,10,0"
                        Click="CancelButton_OnClick"
                        Content="Abbrechen"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Click="CompleteButton_OnClick"
                        Content="Verkauf abschließen"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
