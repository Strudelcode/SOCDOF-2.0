<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SOCDOF</RootNamespace>
    <AssemblyName>SOCDOF</AssemblyName>
    <Version>1.9.2</Version>
    <FileVersion>1.9.2</FileVersion>
    <AssemblyVersion>1.9.2.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Resource Include="src/Assets/logo.png" Condition="Exists('src/Assets/logo.png')" />
    <ApplicationIcon Condition="Exists('src/Assets/app.ico')">src/Assets/app.ico</ApplicationIcon>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
  </ItemGroup>
</Project>
