<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SOCDOF</RootNamespace>
    <AssemblyName>SOCDOF_2.0</AssemblyName>
    <Version>2.0.4</Version>
    <FileVersion>2.0.4</FileVersion>
    <AssemblyVersion>2.0.4.0</AssemblyVersion>
    <Company>Yuri / Strudel</Company>
    <Product>SOCDOF 2.0</Product>
    <Description>Strudel's Organization, Commerce &amp; Documentation Offline Flow</Description>
    <ApplicationIcon Condition="Exists('src/Assets/socdof_v2_icon.ico')">src/Assets/socdof_v2_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Resource Include="src/Assets/socdof_v2_icon.ico" Condition="Exists('src/Assets/socdof_v2_icon.ico')" />
    <Resource Include="src/Assets/socdof_v2_icon.png" Condition="Exists('src/Assets/socdof_v2_icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
  </ItemGroup>
</Project>
